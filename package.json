{
  "name": "streamline-cafe-js",
  "version": "0.2.34-cafe.3",
  "description": "A modern web UI skin for the Decent Espresso DE1, built on top of [Streamline-Bridge (reaprime)](https://github.com/tadelv/reaprime). This is a full rewrite of the original TCL-based Streamline skin into a browser-native web application — no framework, no bundler, just HTML/CSS/JS served as static files.",
  "main": "index.js",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./src/css/app.css --minify",
    "build:echarts": "esbuild scripts/echarts-streamline-entry.js --bundle --format=esm --minify --outfile=src/modules/echarts-streamline.min.js",
    "build": "npm run build:css && npm run build:echarts",
    "watch:css": "tailwindcss -i ./src/input.css -o ./src/css/app.css --watch",
    "test": "node --test test/*.test.mjs",
    "test:page": "playwright test",
    "test:real": "playwright test -c playwright.real.config.mjs",
    "record:fake-decaid": "node scripts/fake-decaid-recorder/record.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loganfuller/streamline-cafe-js.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/loganfuller/streamline-cafe-js/issues"
  },
  "homepage": "https://github.com/loganfuller/streamline-cafe-js#readme",
  "devDependencies": {
    "daisyui": "^4.11.1",
    "echarts": "^6.1.0",
    "esbuild": "^0.25.9",
    "playwright": "^1.65.0",
    "tailwindcss": "^3.4.19"
  }
}
